<QueryParameterMap xmlns="http://santedb.org/model/fhir">

	<type resource="Immunization">
		<queryControl>
			 <!--Immunization queries must have a patient reference--> 
			<parameter>patient</parameter>
		</queryControl>
	</type>

	<type resource="Patient">
		<queryControl>
			<any>
				<parameter pattern="^.*?\|.*$">identifier</parameter>
				<all>
					 <!--Must have address in query--> 
					<any>
						<all>
							<parameter>address-city</parameter>
							<parameter>address-state</parameter>
						</all>
						<all>
							<parameter>address-city</parameter>
							<parameter>address-district</parameter>
						</all>
					</any>
					 <!--Must have FULL name--> 
					<any>
						<all>
							<parameter modifiers="exact approx">given</parameter>
							<parameter modifiers="exact">family</parameter>
						</all>
						<parameter modifiers="exact">name</parameter>
					</any>
					 <!--Must have gender--> 
					<parameter>gender</parameter>
				</all>
			</any>
		</queryControl>
	</type>
</QueryParameterMap>